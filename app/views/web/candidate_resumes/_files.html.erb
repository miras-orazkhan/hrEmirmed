<% if resumes.empty? %><p class="muted">Резюме пока не загружены.</p><% else %><ul class="file-list"><% resumes.each do |resume| %><li><%= link_to resume.original.filename.to_s, candidate_resume_path(@candidate, resume), data: { turbo: false } %><span class="hint"><%= number_to_human_size(resume.original.byte_size) %> · <%= date_label(resume.created_at) %></span></li><% end %></ul><% end %>
