<%= form_with url: candidate_resumes_path(@candidate), multipart: true, class: "form-stack" do |f| %><div class="field"><%= f.label :file, "Добавить резюме" %><%= f.file_field :file, required: true, accept: ".pdf,.doc,.docx,.txt", aria: { describedby: "resume-format" } %><p class="hint" id="resume-format">PDF, DOC, DOCX или TXT, до 10 МБ. Файл скачивается в исходном виде.</p></div><%= f.submit "Загрузить резюме", class: "button button--secondary", data: { turbo_submits_with: "Загружаем…" } %><% end %>
