<% content_for :title, "Кампании" %>
<header class="page-header"><div><h1>Кампании</h1><p class="muted">Запуск подбора по готовым заявкам.</p></div></header>
<%= turbo_frame_tag "workflow_list", data: { turbo_action: "advance" } do %>
<% if @campaigns.any? %><div class="table-wrap"><table><thead><tr><th>Вакансия</th><th>Рекрутер</th><th>Статус</th></tr></thead><tbody>
<% @campaigns.each do |record| %><tr id="<%= dom_id(record) %>"><td data-label="Вакансия"><%= link_to record.vacancy_template.latest_version&.title || "Кампания №#{record.id}", recruitment_campaign_path(record), data: { turbo_frame: "_top" } %></td><td data-label="Рекрутер"><%= record.recruiter.full_name %></td><td data-label="Статус"><%= state_badge(record.status) %></td></tr><% end %>
</tbody></table></div>
<% else %><div class="empty"><h2>Записей пока нет</h2><p class="muted">Здесь появятся доступные вам записи. Если используете поиск, попробуйте изменить запрос.</p></div><% end %>
<%= render "web/shared/pagination" %>
<% end %>
