<%= form_with scope: :job_requisition, url: @requisition.persisted? ? job_requisition_path(@requisition) : job_requisitions_path, method: @requisition.persisted? ? :patch : :post, class: "form-stack" do |f| %>
  <% unless @requisition.persisted? %>
    <div class="field"><%= f.label :department_id, "Подразделение" %><%= f.select :department_id, @departments.map { |department| ["#{department.branch.name} · #{department.name}", department.id] }, { selected: form_value(:job_requisition, :department_id, @requisition.department_id), prompt: "Выберите подразделение" }, required: true %></div>
    <div class="field"><%= f.label :vacancy_template_id, "Утверждённый шаблон вакансии" %><%= f.select :vacancy_template_id, @templates.map { |template| [template.latest_version.title, template.id] }, { selected: form_value(:job_requisition, :vacancy_template_id), prompt: "Выберите шаблон" }, required: true %><% if @templates.empty? %><p class="hint">Сначала HR должен создать и утвердить шаблон вакансии.</p><% end %></div>
  <% end %>
  <div class="field"><%= f.label :positions_count, "Количество мест" %><%= f.number_field :positions_count, value: form_value(:job_requisition, :positions_count, @requisition.positions_count || 1), min: 1, required: true %></div>
  <div class="field"><%= f.label :work_schedule, "График работы" %><%= f.text_area :work_schedule, value: form_value(:job_requisition, :work_schedule, @version&.work_schedule), rows: 3, required: true %></div>
  <div class="form-grid"><div class="field"><%= f.label :salary_amount, "Зарплата" %><%= f.number_field :salary_amount, value: form_value(:job_requisition, :salary_amount, @version&.salary_amount), min: 0, step: "0.01", required: true %></div><div class="field"><%= f.label :salary_currency, "Валюта" %><%= f.text_field :salary_currency, value: form_value(:job_requisition, :salary_currency, @version&.salary_currency || "KZT"), minlength: 3, maxlength: 3, required: true %></div></div>
  <div class="field"><%= f.label :desired_start_on, "Желаемая дата выхода" %><%= f.date_field :desired_start_on, value: form_value(:job_requisition, :desired_start_on, @version&.desired_start_on), required: true %></div>
  <div class="field"><%= f.label :interviewer_id, "Интервьюер" %><%= f.select :interviewer_id, @users.select { |user| user.allows?("conduct.interview") || user.allows?("launch.recruitment_campaign") }.map { |user| ["#{user.full_name} · #{user.branch.name}", user.id] }, { selected: form_value(:job_requisition, :interviewer_id, @version&.interviewer_id), prompt: "Выберите сотрудника" }, required: true %><p class="hint">Интервьюер должен работать в филиале заявки или быть назначенным рекрутером.</p></div>
  <div class="field"><%= f.label :interview_format, "Формат собеседования" %><%= f.select :interview_format, [["Очно", "onsite"], ["Онлайн", "online"]], selected: form_value(:job_requisition, :interview_format, @version&.interview_format) %></div>
  <fieldset><legend>Стажировка, если обязательна в шаблоне</legend><div class="form-stack">
    <div class="field"><%= f.label :internship_supervisor_id, "Руководитель стажировки" %><%= f.select :internship_supervisor_id, @users.select { |user| user.allows?("supervise.internship") }.map { |user| ["#{user.full_name} · #{user.branch.name}", user.id] }, { selected: form_value(:job_requisition, :internship_supervisor_id, @version&.internship_supervisor_id), include_blank: "Не назначен" } %></div>
    <div class="field"><%= f.label :internship_duration, "Длительность стажировки" %><%= f.text_field :internship_duration, value: form_value(:job_requisition, :internship_duration, @version&.internship_duration), placeholder: "Например, 3 смены" %></div>
  </div></fieldset>
  <div class="field"><%= f.label :additional_questions_lines, "Дополнительные вопросы" %><%= f.text_area :additional_questions_lines, value: form_value(:job_requisition, :additional_questions_lines, Array(@version&.additional_questions).join("\n")) %><span class="hint">Каждый вопрос с новой строки.</span></div>
  <div class="actions"><%= f.submit "Сохранить заявку", class: "button", data: { turbo_submits_with: "Сохраняем…" } %><%= link_to "Отмена", job_requisitions_path, class: "button button--quiet" %></div>
<% end %>
