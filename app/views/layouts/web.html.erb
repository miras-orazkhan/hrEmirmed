<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · HR Emirmed" : "HR Emirmed" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="turbo-cache-control" content="no-cache">
    <% if controller_name == "sessions" %><meta name="turbo-visit-control" content="reload"><% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <a class="skip-link" href="#main">К содержимому</a>
    <% if current_user %>
      <div class="workspace">
        <aside class="sidebar">
          <%= link_to "HR Emirmed", root_path, class: "brand" %>
          <p class="sidebar-caption">Рабочее пространство</p>
          <nav aria-label="Основная навигация">
            <% workspace_navigation.each do |item| %>
              <%= link_to item[:label], item[:path], class: "nav-link",
                aria: { current: item[:active] ? "page" : nil } %>
            <% end %>
          </nav>
          <div class="account"><strong><%= current_user.full_name %></strong><span><%= current_user.branch.name %></span><%= button_to "Выйти", session_path, method: :delete, class: "button button--quiet", data: { turbo_submits_with: "Выход…" } %></div>
        </aside>
        <main id="main" class="main" tabindex="-1"><%= render "web/shared/notices" %><%= yield %></main>
      </div>
    <% else %>
      <main id="main" class="login-shell"><%= render "web/shared/notices" %><%= yield %></main>
    <% end %>
  </body>
</html>
